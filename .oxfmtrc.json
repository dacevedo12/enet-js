{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": {
    "groups": [
      ["type-builtin", "value-builtin"],
      ["type-external", "value-external"],
      [
        "type-parent",
        "type-sibling",
        "type-index",
        "value-parent",
        "value-sibling",
        "value-index"
      ],
      "unknown"
    ]
  },
  "sortPackageJson": true
}
