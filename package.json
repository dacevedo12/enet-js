{
  "author": "https://github.com/dacevedo12",
  "bugs": {
    "url": "https://github.com/dacevedo12/enet-js/issues"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "description": "Node.js bindings for ENet, the reliable UDP networking library",
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "markdownlint-cli": "0.49.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/dacevedo12/enet-js",
  "keywords": [
    "backend",
    "enet",
    "networking",
    "udp"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "enet-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dacevedo12/enet-js.git"
  },
  "scripts": {
    "build": "rm -rf ./dist/ && tsc --project tsconfig.build.json",
    "lint-code": "tsc && oxlint && oxfmt --check src",
    "lint-docs": "markdownlint README.md",
    "test": "vitest run",
    "format": "oxfmt src"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.3.1"
}
