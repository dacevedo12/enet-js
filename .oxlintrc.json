{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every category of every plugin that applies to a Node.js TypeScript library
  // is an error. A rule only appears below when it contradicts another rule, a
  // tool that owns the concern, the platform, or a deliberate API decision.
  // Anything else gets fixed in the code, or at most disabled on a single line
  // with `// oxlint-disable-next-line <rule> -- <reason>`.
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "node",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "ignorePatterns": ["coverage/**", "dist/**"],
  "rules": {
    // Contradictory rules: keep one side
    "import/no-named-export": "off", // import/no-default-export is on: named exports only
    "import/prefer-default-export": "off", // import/no-default-export is on: named exports only
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }], // import/consistent-type-specifier-style requires separate type-only imports
    "no-ternary": "off", // contradicts unicorn/prefer-ternary
    "one-var": ["error", "never"], // one declaration per statement
    "vitest/no-importing-vitest-globals": "off", // vitest globals are disabled, so tests import them
    "vitest/prefer-describe-function-title": "off", // vitest/valid-title requires string titles
    "vitest/prefer-to-be-truthy": "off", // toBe(true) is stricter than toBeTruthy()

    // Owned by another tool
    "jsdoc/require-param-type": "off", // TypeScript owns parameter types
    "jsdoc/require-returns-type": "off", // TypeScript owns return types
    "no-redeclare": "off", // tsc reports redeclarations; this rule misreads const and type pairs
    "require-await": "off", // superseded by the type-aware typescript/require-await
    "sort-imports": ["error", { "ignoreDeclarationSort": true }], // oxfmt orders import declarations
    "unicorn/number-literal-case": "off", // oxfmt lowercases number literals

    // Platform and target
    "import/no-nodejs-modules": "off", // enet-js is a Node.js library
    "no-undefined": "off", // optional values are compared with undefined under noUncheckedIndexedAccess
    "node/no-process-env": [
      "error",
      { "allowedVariables": ["CC", "ENET_INCLUDE_PATH", "ENET_LIB_PATH"] }
    ],
    "oxc/no-async-await": "off", // targets ES2024
    "oxc/no-optional-chaining": "off", // targets ES2024
    "oxc/no-rest-spread-properties": "off", // targets ES2024
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          { "from": "package", "name": "Buffer", "package": "@types/node" },
          { "from": "file", "name": "NativePointer" },
          { "from": "file", "name": "IENetHost" },
          { "from": "file", "name": "IENetPacket" },
          { "from": "file", "name": "IENetPeer" },
          { "from": "lib", "name": "ReadonlySet" },
          { "from": "lib", "name": "Set" }
        ]
      }
    ], // Buffer is mutable by design; tsgolint misreads readonly properties holding the NativePointer brand as mutable; handles have the fields ENet documents as writable; socketset.select updates Sets in place like fd_set, and tsgolint treats ReadonlySet methods as mutable

    // Deliberate API design
    "max-params": ["error", { "max": 5 }], // wrappers mirror ENet's C signatures; enet_host_create has 5
    "new-cap": ["error", { "capIsNewExceptionPattern": "^ENET_" }], // ENet's macros keep their C names as functions
    "unicorn/no-null": "off", // null mirrors C's NULL, and Koffi returns null for NULL pointers

    // Stricter than the default
    "no-magic-numbers": ["error", { "enforceConst": true }]
  }
}
